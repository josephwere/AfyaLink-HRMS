# Core backend
NODE_ENV=development
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/afyalink
JWT_SECRET=replace_me
JWT_ACCESS_SECRET=replace_me
FRONTEND_URL=http://localhost:5173
# Optional explicit public app URL for production canonical links
FRONTEND_PUBLIC_URL=
METRICS_TOKEN=
AUDIT_LOG_IMMUTABLE=0
AUDIT_RETENTION_DAYS=365

# Email delivery
# Preferred provider: Brevo API
BREVO_API_KEY=
BREVO_SENDER_NAME=AfyaLink HRMS
BREVO_SENDER_EMAIL=no-reply@example.com
# Optional combined sender value, e.g. AfyaLink HRMS <no-reply@example.com>
BREVO_SENDER=
BREVO_CONTACT_LIST_IDS=
# Optional role-specific lists, for example:
# BREVO_CONTACT_LIST_IDS_PATIENT=2
# BREVO_CONTACT_LIST_IDS_DOCTOR=5
BREVO_SMOKE_TO=
BREVO_SMOKE_SANDBOX=1

# Fallback SMTP / Gmail-compatible transport
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Legacy aliases still supported
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=

# SMS / OTP providers
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_NUMBER=
# Legacy alias still supported
TWILIO_PHONE_NUMBER=
TWILIO_WHATSAPP_FROM=

# Africa's Talking
AFRICASTALKING_USERNAME=sandbox
AFRICASTALKING_API_KEY=
# Legacy aliases still supported
AT_USERNAME=
AT_API_KEY=

# Optional secondary provider
SENDGRID_API_KEY=

EMAIL_TIMEOUT_MS=15000

# Asset delivery / CDN-backed branding
# Default local storage writes to /uploads. To enable durable CDN-backed branding media:
ASSET_STORAGE_PROVIDER=local
PUBLIC_ASSET_CDN_URL=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Durable background jobs
BACKGROUND_JOB_POLL_MS=5000
BACKGROUND_JOB_CONCURRENCY=2

# SHA (national health fund) integration
SHA_BASE_URL=
SHA_TOKEN_URL=
SHA_PREAUTH_URL=
SHA_CLIENT_ID=
SHA_CLIENT_SECRET=
SHA_API_TOKEN=
SHA_AUDIENCE=
SHA_TIMEOUT_MS=8000
SHA_MOCK_MODE=0

# eTIMS (tax compliance) integration
ETIMS_BASE_URL=
ETIMS_TOKEN_URL=
ETIMS_INVOICE_URL=
ETIMS_CLIENT_ID=
ETIMS_CLIENT_SECRET=
ETIMS_API_KEY=
ETIMS_API_TOKEN=
ETIMS_TIMEOUT_MS=8000

# M-PESA runtime credentials (for STK push)
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_CALLBACK_URL=

# Upstash Redis (optional but recommended in production)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# NeuroEdge gateway
NEUROEDGE_API_BASE=https://neuroedge-400s.onrender.com
# Optional failover hosts if NeuroEdge gives you secondary upstreams
NEUROEDGE_API_BASE_FAILOVER=
NEUROEDGE_API_KEY=replace_with_secure_token
# Optional if bearer is used instead of api key
# NEUROEDGE_BEARER_TOKEN=replace_with_secure_bearer
# Optional for OpenAI-compatible deployments that require an explicit model
NEUROEDGE_CHAT_MODEL=

NEUROEDGE_TIMEOUT_MS=30000
NEUROEDGE_RETRIES=2
NEUROEDGE_RETRY_BACKOFF_MS=300
NEUROEDGE_CIRCUIT_THRESHOLD=5
NEUROEDGE_CIRCUIT_COOLDOWN_MS=15000
