{
  "name": "afyalink-hrms-backend",
  "version": "1.0.0",
  "type": "module",
  "main": "server.js",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "NODE_ENV=development nodemon --watch . --exec \"node server.js\"",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest --runInBand",
    "authz:regression": "node scripts/authz-regression.mjs",
    "audit:route-lockdown": "node scripts/route-lockdown-audit.mjs",
    "audit:abac-tests": "node scripts/abac-regression-audit.mjs",
    "security:gate": "npm run audit:route-lockdown && npm run authz:regression && npm run audit:abac-tests",
    "preprod:preflight": "NODE_ENV=production node scripts/production-preflight.mjs",
    "preprod:gate": "npm run preprod:preflight && npm run security:gate && npm run test",
    "readiness:program": "node scripts/readiness-program-status.mjs",
    "phase0:gate": "npm run readiness:program && npm run security:gate && npm run test",
    "phase1:gate": "npm run phase0:gate && npm run chaos:drill:plan && npm run compliance:evidence && npm run preprod:preflight",
    "phase2:gate": "npm run phase1:gate && npm run compliance:evidence:full && npm run failover:evidence:capture",
    "phase3:gate": "npm run phase2:gate && npm run staging:failover:run && npm run hypercare:kpi:snapshot",
    "phase4:gate": "npm run phase3:gate && npm run global:readiness:verify && npm run global:wave:plan",
    "phase5:gate": "npm run phase4:gate && npm run phase5:launch:verify && npm run launch:command-center:snapshot",
    "phase6:gate": "npm run phase5:gate && npm run exec:readiness:report && npm run postlaunch:review:init -- \"Global Launch\"",
    "compliance:evidence": "node scripts/compliance-evidence-pack.mjs",
    "compliance:evidence:full": "node scripts/compliance-evidence-pack.mjs --full",
    "pilot:onboarding:init": "node scripts/pilot-onboarding-init.mjs",
    "chaos:drill:plan": "node scripts/chaos-drill-runner.mjs",
    "audit:retention:dry": "node scripts/audit-retention-sweep.mjs --dry-run",
    "audit:retention:run": "node scripts/audit-retention-sweep.mjs",
    "failover:evidence:capture": "node scripts/failover-evidence-capture.mjs",
    "staging:failover:run": "node scripts/staging-failover-run.mjs",
    "pilot:cutover:run": "node scripts/pilot-cutover-runner.mjs",
    "hypercare:kpi:snapshot": "node scripts/hypercare-kpi-snapshot.mjs",
    "global:country:init": "node scripts/global-country-pack-init.mjs",
    "global:wave:plan": "node scripts/global-wave-plan.mjs",
    "global:wave:execute": "node scripts/global-wave-execute.mjs",
    "global:readiness:verify": "node scripts/global-readiness-verify.mjs",
    "launch:command-center:snapshot": "node scripts/launch-command-center-snapshot.mjs",
    "phase5:launch:verify": "node scripts/phase5-launch-verify.mjs",
    "exec:readiness:report": "node scripts/executive-readiness-report.mjs",
    "postlaunch:review:init": "node scripts/postlaunch-review-init.mjs",
    "readiness:legal-only": "node scripts/legal-only-readiness-gate.mjs",
    "neuroedge:sync-indexes": "node scripts/neuroedge-gateway-sync-indexes.mjs",
    "test:gateway:ci": "NODE_OPTIONS=--experimental-vm-modules jest --runInBand tests/aiGatewayController.test.js tests/neuroedgeGatewayContract.test.js tests/aiGateway.integration.test.js tests/aiGateway.load.test.js",
    "test:gateway:ci:strict": "NODE_OPTIONS=--experimental-vm-modules jest --runInBand --detectOpenHandles tests/aiGatewayController.test.js tests/neuroedgeGatewayContract.test.js tests/aiGateway.integration.test.js tests/aiGateway.load.test.js",
    "lint": "eslint . --ext .js,.jsx || true",
    "format": "prettier --write \"**/*.{js,jsx,json,md,css}\" || true",
    "start:prod": "NODE_ENV=production node server.js",
    "perf:k6:global-burst": "k6 run perf/k6/global-burst.js"
  },
  "dependencies": {
    "@automerge/automerge": "^2.0.5",
    "@medplum/fhirtypes": "^2.1.2",
    "@sendgrid/mail": "^7.7.0",
    "axios": "^1.5.0",
    "bcryptjs": "^2.4.3",
    "bull": "^4.10.0",
    "bullmq": "^5.12.0",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dayjs": "^1.11.10",
    "dotenv": "^16.0.0",
    "africastalking": "^0.6.4",
    "dotenv-expand": "^10.0.0",
    "exceljs": "^4.4.0",
    "express": "^4.18.2",
    "handlebars": "^4.7.7",
    "ioredis": "^5.3.2",
    "jsonwebtoken": "^9.0.0",
    "moment": "^2.30.1",
    "mongoose": "^7.0.0",
    "morgan": "^1.10.0",
    "multer": "1.4.5-lts.1",
    "node-cron": "^3.0.3",
    "node-fetch": "^2.6.7",
    "nodemailer": "^6.9.0",
    "pdfkit": "^0.13.0",
    "socket.io": "^4.7.1",
    "stripe": "^14.0.0",
    "twilio": "^4.0.0",
    "uuid": "^9.0.0",
    "web-push": "^3.5.0",
    "openai": "^4.0.0",
    "express-rate-limit": "^6.9.0",
    "hl7": "^1.0.0",
    "@upstash/redis": "^1.31.0",
    "speakeasy": "^2.0.0",
    "ws": "^8.14.2",
    "google-auth-library": "^9.6.0",
    "json2csv": "5.0.7"
  },
  "devDependencies": {
    "jest": "^29.6.1",
    "mongodb-memory-server": "^8.12.1",
    "nodemon": "^2.0.22",
    "supertest": "6.3.4"
  }
}
