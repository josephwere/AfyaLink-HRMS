    },
    {
      "source": "/healthz",
      "destination": "https://afya-link-hrms-frontend-4.onrender.com/healthz"
    },
    {
      "source": "/socket.io/(.*)",
      "destination": "https://afya-link-hrms-frontend-4.onrender.com/socket.io/$1"
    },
    {
      "source": "/uploads/(.*)",
